//
// Secrets.xcconfig.example
// Copy this file to Secrets.xcconfig and fill in your keys.
// Secrets.xcconfig is gitignored and must not be committed.
//
// IMPORTANT: In .xcconfig files, // starts a comment. Write https URLs as:
//   https:/$()/YOUR_PROJECT.supabase.co
// so the // is not stripped at build time.
//

GEMINI_API_KEY = your_gemini_api_key_here
USDA_API_KEY = your_usda_api_key_here
SUPABASE_URL = https:/$()/YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY = your_supabase_anon_key_here
